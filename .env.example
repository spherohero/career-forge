# Local/runtime configuration
AUTH_MODE=disabled
AUTH_ALLOWED_GROUPS=admins
AUTH_ALLOWED_USERS=
DATABASE_PATH=./data/career-forge.db
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_ALLOW_INSECURE_LOCAL=false
CODEX_OAUTH_ENABLED=false
CREDENTIAL_ENCRYPTION_KEY=
CODEX_MODEL=gpt-5.6-sol

# Production Compose configuration
CAREER_FORGE_AUTH_ALLOWED_GROUPS=admins
# The named volume is the ownership-safe default.
# Bind paths must be pre-created with owner 1001:1001, mode 0750, and backed up.
CAREER_FORGE_DATA_SOURCE=career_forge_data
CAREER_FORGE_DATA_VOLUME=career_forge_data
CAREER_FORGE_PROXY_NETWORK=career_proxy
CAREER_FORGE_HOST=career.example.com
CAREER_FORGE_AUTH_MIDDLEWARE=authelia@docker
CAREER_FORGE_ENTRYPOINT=websecure
CAREER_FORGE_CERT_RESOLVER=letsencrypt
# Set to a strong secret in the production environment; do not commit it.
CAREER_FORGE_CREDENTIAL_ENCRYPTION_KEY=
